# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
*.log

# Vite public dir: ignore generated content (optimized album art, transcoded
# music, copied data JSON) but keep tracked static files (manifest.json,
# sw.js, proxy.php, and the UI icons in public/img/assets/).
/public/img/*
!/public/img/assets/
!/public/img/placeholders/
/public/music/
/public/data/
/public/img/covers/

# Generated sleeve masters — large PNGs from gpt-image-2. The processed,
# shipped set in public/img/placeholders/ is what's tracked.
/_sleeves/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment variables
.env
.env.local
.env.*.local

# Server-side secrets — proxy.config.php lives only on the VPS.
# proxy.config.example.php (committed) shows what shape it should have.
/public/proxy.config.php

# Claude
.claude/

# Temporary files
*.tmp
temp/
